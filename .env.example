# Qloo hackathon key. Hackathon keys only work against https://hackathon.api.qloo.com.
# Leave empty to run on built-in demo data.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Anthropic key for reference extraction and swap rewrites.
# Leave empty to fall back to a keyword extractor over the demo data.
ANTHROPIC_API_KEY=
CALLBACK_EXTRACT_MODEL=claude-haiku-5-5

# Optional: Upstash Redis for caching Qloo responses and rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Qloo hackathon key. Hackathon keys only work against https://hackathon.api.qloo.com.
# Leave empty to run on the built-in demo fixtures (invented numbers, labelled "Demo data").
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Optional: any OpenAI-compatible model for the "Fix my set" agent (Groq's free tier by default).
# Without it the agent runs on rules.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=

# Optional: Upstash Redis, a shared cache for Qloo responses across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
